    .sobre .lead-text { font-size: 1rem; color: #444; line-height: 1.7; margin-bottom: 1.5rem; }
    .sobre .acento { width: 40px; height: 3px; background: var(--naranja); border-radius: 2px; margin-bottom: 1.5rem; }
    .valor-card { border: 1px solid #e8eaf0; border-radius: 10px; padding: 24px 22px; height: 100%; transition: box-shadow .2s, transform .2s; }
    .valor-card:hover { box-shadow: 0 6px 24px rgba(26,91,181,.1); transform: translateY(-3px); }
    .valor-icon { width: 44px; height: 44px; border-radius: 10px; background: #eef3fc; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
    .valor-icon svg { width: 22px; height: 22px; fill: var(--azul); }
    .valor-card h5 { font-family: 'Sora', sans-serif; font-weight: 600; font-size: .95rem; margin-bottom: .4rem; }
    .valor-card p { font-size: .875rem; color: #555; margin: 0; line-height: 1.6; }
    .img-wrap { border-radius: 14px; overflow: hidden; position: relative; }
    .img-badge { position: absolute; bottom: 20px; left: 20px; background: #fff; border-radius: 10px; padding: 12px 18px; box-shadow: 0 4px 16px rgba(0,0,0,.12); display: flex; align-items: center; gap: 10px; }
    .img-badge .num { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1.4rem; color: var(--azul); line-height: 1; }
    .img-badge .sub { font-size: .75rem; color: #666; line-height: 1.3; }
    .stats-band { background: var(--gris-claro); border-top: 1px solid #e5e7ef; border-bottom: 1px solid #e5e7ef; padding: 40px 0; }
    .stat-item { text-align: center; }
    .stat-item .num { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 2rem; color: var(--azul); line-height: 1; }
    .stat-item .num span { color: var(--naranja); }
    .stat-item .lbl { font-size: .82rem; color: #666; margin-top: 4px; }
    .equipo { padding: 72px 0; background: #fff; }
    .equipo h2 { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1.6rem; margin-bottom: .3rem; }
    .equipo .sub { color: #666; font-size: .95rem; margin-bottom: 2.5rem; }
    .miembro-card { border: 1px solid #e8eaf0; border-radius: 12px; overflow: hidden; transition: box-shadow .2s, transform .2s; }
    .miembro-card:hover { box-shadow: 0 6px 20px rgba(26,91,181,.1); transform: translateY(-3px); }
    .avatar-placeholder { width: 100%; aspect-ratio: 1/1; background: linear-gradient(135deg, #dde6f5 0%, #c4d4ee 100%); display: flex; align-items: center; justify-content: center; }
    .avatar-placeholder svg { width: 56px; height: 56px; fill: var(--azul); opacity: .5; }
    .miembro-info { padding: 16px; }
    .miembro-info h6 { font-family: 'Sora', sans-serif; font-weight: 600; font-size: .95rem; margin-bottom: 2px; }
    .miembro-info .rol { font-size: .8rem; color: var(--naranja); font-weight: 500; }
    .miembro-info p { font-size: .8rem; color: #666; margin: 8px 0 0; line-height: 1.5; }
    .cta-band { background: var(--azul); color: #fff; padding: 56px 0; text-align: center; }
    .cta-band h3 { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1.6rem; margin-bottom: .6rem; }
    .cta-band p { opacity: .88; margin-bottom: 1.6rem; }
    .btn-cta-primary { background: var(--naranja); color: #fff; border: none; border-radius: 8px; padding: 12px 28px; font-weight: 600; font-size: .95rem; text-decoration: none; transition: background .2s; }
    .btn-cta-primary:hover { background: #d06518; color: #fff; }
    .btn-cta-outline { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,.5); border-radius: 8px; padding: 12px 28px; font-weight: 500; font-size: .95rem; text-decoration: none; margin-left: 12px; transition: border-color .2s; }
    .btn-cta-outline:hover { border-color: #fff; color: #fff; }
    @media (max-width: 767px) {
      .hero-strip h1 { font-size: 1.5rem; }
      .stat-item .num { font-size: 1.5rem; }
