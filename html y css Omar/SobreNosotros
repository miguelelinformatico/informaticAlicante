  <style>
    :root {
      --azul: #1a5bb5;
      --naranja: #e87020;
      --gris-claro: #f5f6f8;
      --texto: #1a1a1a;
    }
    body { font-family: 'Inter', sans-serif; color: var(--texto); background: #fff; }
    .navbar { border-bottom: 1px solid #e0e0e0; }
    .navbar-brand { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1.25rem; color: var(--texto) !important; }
    .navbar-brand span { color: var(--naranja); }
    .nav-link { font-size: .9rem; color: #333 !important; }
    .nav-link:hover { color: var(--azul) !important; }
    .btn-registro { background: var(--azul); color: #fff !important; border-radius: 6px; font-size: .85rem; padding: 6px 16px; }
    .btn-registro:hover { background: #154ea0; }
    .hero-strip { background: var(--azul); color: #fff; padding: 48px 0 44px; }
    .hero-strip h1 { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 2rem; margin-bottom: .4rem; }
